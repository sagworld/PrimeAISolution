{
  "name": "primeaisolution",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ai:server": "node server/ai-server.js",
    "worker:dev": "wrangler dev",
    "worker:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply prime-ai-lab --local",
    "db:migrate:remote": "wrangler d1 migrations apply prime-ai-lab --remote",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "html2pdf.js": "^0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "wrangler": "^4.165.0"
  }
}
